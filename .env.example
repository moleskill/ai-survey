# Скопируй этот файл в .env.local и заполни значения.
# Для Vercel те же переменные добавляются в Settings -> Environment Variables.

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Ключ service_role (или новый secret key). Никому не показывай и не публикуй на GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Данные единственного администратора. Регистрации пользователей в приложении нет.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# true = один браузер может пройти опрос только один раз.
# На общих школьных компьютерах оставь false, иначе второй ученик за тем же ПК не сможет ответить.
NEXT_PUBLIC_BLOCK_REPEAT=false
